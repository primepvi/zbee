const name = "Bee"
let a = true
let b = false

let age = 18
let status = when age >= 18
    then "+18" otherwise "-18"

echo status

if a and not b then
    echo "hello"
else
    let b = 0
    while b < 10 do
        echo b
        b = b + 1

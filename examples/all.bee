for let i = 0, i < 10, i = i + 1 do
    if i % 2 == 0 -> echo "par"
    else echo "impar"
end

let i = 0
while i < 10 do
      i = i + 1
      echo i
end

fn hello(): void
   echo "Hello, World"
end

hello()

fn factorial(n: int): int
   if n < 0 -> return 0
   if n == 0 or n == 1 -> return 1

   return n * factorial(n - 1)
end

fn divide(x: int, y: int): int?
   return when y == 0 then null otherwise x / y
end

let c = factorial(5)
let d: int? = divide(0, 0)

echo c
echo d